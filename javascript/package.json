{
  "name": "@crawlora-org/tiktok",
  "version": "0.1.3",
  "description": "Crawlora TikTok API client with 25 endpoints for video, user, and hashtag search; profiles and posts; comments; trends; Creative Center; and Top Ads data",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=tiktok-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-tiktok/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "tiktok", "tiktok-api", "tiktok-scraper", "tiktok-data", "tiktok-video", "tiktok-user", "tiktok-hashtag-search", "tiktok-profiles-posts", "tiktok-comments", "tiktok-trends", "tiktok-creative-center", "tiktok-top-ads-data"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-tiktok",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
