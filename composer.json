{
  "name": "crawlora/tiktok",
  "description": "Crawlora TikTok API client with 28 endpoints for video, user, and hashtag search; profiles and posts; comments; trends; Creative Center; and Top Ads data",
  "keywords": [
    "crawlora",
    "api-client",
    "sdk",
    "web-scraping",
    "scraping-api",
    "tiktok",
    "tiktok-api",
    "tiktok-scraper",
    "tiktok-data",
    "tiktok-video",
    "tiktok-user",
    "tiktok-hashtag-search",
    "tiktok-profiles-posts",
    "tiktok-comments",
    "tiktok-trends",
    "tiktok-creative-center",
    "tiktok-top-ads-data"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Tiktok\\": "php/src/Crawlora/Tiktok/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Tiktok\\Tests\\": "php/tests/"
    }
  },
  "scripts": {
    "test": "php php/tests/client_test.php"
  },
  "homepage": "https://crawlora.net/?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=tiktok-php-homepage",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-tiktok",
    "docs": "https://crawlora.net/docs?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=tiktok-php-api-docs"
  }
}
